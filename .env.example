# Full-key template. Each environment reads exactly ONE file, with no fallback
# between them (see src/constants/env-file.constant.ts), so copy this whole file
# per environment and change the values:
#
#   development  ->  cp .env.example .env.development   (pnpm start:dev)
#   production   ->  cp .env.example .env               (pnpm start:prod)
#   test (e2e)   ->  cp .env.test.example .env.test     (pnpm test:e2e)
#
# Real process environment variables always win over the file, which is how
# Docker/CI inject production secrets without shipping a `.env` at all.

# development | production | test
NODE_ENV=development
PORT=4000
ACCESS_TOKEN_SECRET=crud_dxt
ACCESS_TOKEN_EXPIRES_IN=5m
REFRESH_TOKEN_SECRET=crud_dxt_refresh
REFRESH_TOKEN_EXPIRES_IN=1d
SECRET_API_KEY=crud_dxt_secret

# Database the app and `prisma migrate` connect to.
# Production tip: append libpq options so a migration that cannot take its lock
# fails fast instead of queueing behind a long transaction and blocking reads:
#   ...?schema=public&options=-c%20lock_timeout%3D5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecom_prod?schema=public"

# Only needed for `pnpm prisma:migrate:drift` (schema vs migration-history check)
# and for `prisma migrate dev` when the DB user may not create databases.
# Must point at a SEPARATE, throwaway database — Prisma resets it.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecom_shadow?schema=public"

LOG_PRETTY=true
LOG_LEVEL=debug

# Redis - used to cache role/permission lookups so the auth guard does not
# hit Postgres on every authenticated request.
REDIS_URL="redis://localhost:6379"


# Seed data
ADMIN_NAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_PHONE_NUMBER=0123456789


#OTP
OTP_EXPIRES_IN=5m
RESEND_API_KEY=
SANDBOX_EMAIL=dangxuanthangqt@gmail.com


# Oauth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

GOOGLE_REDIRECT_CLIENT_URI=http://localhost:3000/oauth/google

# S3
S3_REGION=ap-northeast-1
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=


# Rate limiting.
#
# THROTTLE_ENABLED=false removes every brute-force limit — the API logs a
# warning at boot when it is off. Only the e2e suite is expected to set it
# false, so a run of hundreds of requests from one address does not trip a
# limit it is not testing.
THROTTLE_ENABLED=true

# Number of reverse proxies in front of the app. It selects which entry of
# `X-Forwarded-For` express trusts, and therefore which address the rate
# limiter counts. 0 ignores the header entirely and uses the socket address.
# Setting it higher than the real number of proxies lets a caller forge its own
# address and get a fresh limit budget on every request.
TRUST_PROXY_HOPS=0
