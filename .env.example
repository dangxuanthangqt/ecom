NODE_ENV=development
PORT=4000
ACCESS_TOKEN_SECRET=crud_dxt
ACCESS_TOKEN_EXPIRES_IN=5m
REFRESH_TOKEN_SECRET=crud_dxt_refresh
REFRESH_TOKEN_EXPIRES_IN=1d
SECRET_API_KEY=crud_dxt_secret

# Database the app and `prisma migrate` connect to.
# Production tip: append libpq options so a migration that cannot take its lock
# fails fast instead of queueing behind a long transaction and blocking reads:
#   ...?schema=public&options=-c%20lock_timeout%3D5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecom_prod?schema=public"

# Only needed for `pnpm prisma:migrate:drift` (schema vs migration-history check)
# and for `prisma migrate dev` when the DB user may not create databases.
# Must point at a SEPARATE, throwaway database — Prisma resets it.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecom_shadow?schema=public"

LOG_PRETTY=true
LOG_LEVEL=debug

# Redis - used to cache role/permission lookups so the auth guard does not
# hit Postgres on every authenticated request.
REDIS_URL="redis://localhost:6379"


# Seed data
ADMIN_NAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_PHONE_NUMBER=0123456789


#OTP
OTP_EXPIRES_IN=5m
RESEND_API_KEY=
SANDBOX_EMAIL=dangxuanthangqt@gmail.com


# Oauth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

GOOGLE_REDIRECT_CLIENT_URI=http://localhost:3000/login-google/success

# S3
S3_REGION=ap-northeast-1
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=

