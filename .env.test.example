# Overrides layered on top of `.env` for e2e runs. `ConfigModule.forRoot` reads
# `.env.${NODE_ENV}` first and `.env` second, and dotenv never overwrites an
# already-set key, so every other value (tokens, OTP, S3, admin credentials)
# falls through from `.env` unchanged.
#
# Copy to `.env.test` locally: `cp .env.test.example .env.test`.
NODE_ENV=test

# A separate database on the same Postgres instance `.env`'s DATABASE_URL
# points at. `scripts/prepare-e2e-database.sh` refuses to run unless this
# contains "ecom_e2e", so it can never be pointed at dev/prod by mistake.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecom_e2e?schema=public"

# Redis logical DB 1 — kept separate from dev's DB 0 so `FLUSHDB` in the setup
# script can never touch the dev role-permission cache.
REDIS_URL="redis://localhost:6379/1"

# `EmailService`'s constructor calls `new Resend(key)`, which throws unless
# `key` is a truthy string — even though `AuthService.sendOTP`'s actual send
# call is dead code (see phase-01 Key Insight 8) and never runs in tests. Any
# non-empty value satisfies it; no network call happens and no real key is
# required. Only needed as a `.env.test` override because a local `.env` may
# leave `RESEND_API_KEY` blank for development.
RESEND_API_KEY="re_e2e_dummy_key"
