# e2e environment — the ONLY file an e2e run reads (`test/e2e/support/load-test-env.ts`
# forces NODE_ENV=test, and each environment now maps to exactly one file; there
# is no fallback to `.env`). So this file has to be complete on its own: every
# key `src/validations/env.validation.ts` requires must be present.
#
# Copy to `.env.test` locally: `cp .env.test.example .env.test`.
NODE_ENV=test
PORT=4001

# A separate database on the same Postgres instance dev points at.
# `scripts/prepare-e2e-database.sh` refuses to run unless this contains
# "ecom_e2e", so it can never be pointed at dev/prod by mistake.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecom_e2e?schema=public"

# Redis logical DB 1 — kept separate from dev's DB 0 so `FLUSHDB` in the setup
# script can never touch the dev role-permission cache.
REDIS_URL="redis://localhost:6379/1"

ACCESS_TOKEN_SECRET=e2e_access_secret
ACCESS_TOKEN_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=e2e_refresh_secret
REFRESH_TOKEN_EXPIRES_IN=1d
SECRET_API_KEY=e2e_secret_api_key

LOG_PRETTY=false
LOG_LEVEL=error

# Seed data
ADMIN_NAME=admin
ADMIN_PASSWORD=Aa@123456
ADMIN_EMAIL=admin@gmail.com
ADMIN_PHONE_NUMBER=0123456789

# OTP
OTP_EXPIRES_IN=5m

# `EmailService`'s constructor calls `new Resend(key)`, which throws unless
# `key` is a truthy string — even though `AuthService.sendOTP`'s actual send
# call is dead code (see phase-01 Key Insight 8) and never runs in tests. Any
# non-empty value satisfies it; no network call happens and no real key is
# required.
RESEND_API_KEY="re_e2e_dummy_key"
SANDBOX_EMAIL=e2e@example.com

# Oauth2 — never called in e2e, but AppConfigService reads them at boot.
GOOGLE_CLIENT_ID=e2e-client-id
GOOGLE_CLIENT_SECRET=e2e-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4001/auth/google/callback
GOOGLE_REDIRECT_CLIENT_URI=http://localhost:3000/login-google/success

# S3 — same: read at boot, never called.
S3_REGION=ap-northeast-1
S3_BUCKET_NAME=ecom-e2e
S3_ACCESS_KEY=e2e-access-key
S3_SECRET_KEY=e2e-secret-key

# Off for the suite at large: specs fire hundreds of requests from 127.0.0.1 and
# would otherwise trip the IP limit while testing something else entirely.
# `auth-rate-limit.e2e-spec.ts` sets this back to "true" before booting its own
# app, so the limiter is still exercised against real Redis with real policy.
THROTTLE_ENABLED=false
TRUST_PROXY_HOPS=0
